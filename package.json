  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattoopie/pi-openspec-status.git"
  },
  "bugs": {
    "url": "https://github.com/mattoopie/pi-openspec-status/issues"
  },
  "homepage": "https://github.com/mattoopie/pi-openspec-status#readme",
  "type": "module",
  "peerDependencies": {
